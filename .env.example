# Supabase project connection (see README.md > Deployment / Environment variables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by server actions/route handlers that must bypass RLS
# (e.g. scheduled jobs). Never expose to the client, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables AI-generated weekly/period summaries (Claude Haiku 4.5 —
# a cost-conscious choice for this small, templated summarization task). If
# unset or the call fails, the app falls back to a rules-based plain-language
# summary — AI is never required for the app to be useful.
# ANTHROPIC_API_KEY=
